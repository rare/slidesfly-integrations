    "validate": "node validate.mjs dist"
  },
  "dependencies": {
    "@open-slide/core": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "vite": "5.4.21"
  }
}
